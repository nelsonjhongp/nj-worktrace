{
  "name": "nj-worktrace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "pnpm db:test:reset && vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:check": "tsx scripts/db-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:test:reset": "tsx scripts/db-test-reset.ts",
    "container:build": "docker compose build app",
    "container:up": "docker compose up -d --build app",
    "container:down": "docker compose down",
    "container:logs": "docker compose logs -f app",
    "container:check": "node scripts/container-check.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.2.12",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.0.0 <25"
  }
}
