# PostgreSQL container (local development)
POSTGRES_USER=nj_worktrace
POSTGRES_PASSWORD=nj_worktrace_dev
POSTGRES_DB=nj_worktrace
POSTGRES_PORT=5432

# Application
DATABASE_URL=postgresql://nj_worktrace:nj_worktrace_dev@127.0.0.1:5432/nj_worktrace
TEST_DATABASE_URL=postgresql://nj_worktrace:nj_worktrace_dev@127.0.0.1:5432/nj_worktrace_test
NODE_ENV=development

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-minimum-32-characters-long
BETTER_AUTH_URL=http://localhost:3000
